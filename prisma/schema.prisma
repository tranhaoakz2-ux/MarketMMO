generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kept as plain strings (not native Prisma enums) even though PostgreSQL
// supports them — these fields were originally added on SQLite (no enum
// support there) and app code already treats them as validated strings via
// the TypeScript union types in src/lib/constants.ts. Converting to native
// `enum` blocks is a safe follow-up if wanted, but isn't required for the
// SQLite → PostgreSQL migration itself. Allowed values per field:
//   User.role            "BUYER" | "SELLER" | "ADMIN"
//   Order.status          "ESCROW" | "RELEASED" | "CANCELLED" | "DISPUTED"
//   OrderItem.status       same as Order.status
//   WalletTransaction.type   "DEPOSIT" | "PURCHASE" | "PAYOUT" | "REFUND" |
//                            "REFERRAL_BONUS" | "WITHDRAW" | "INSURANCE_DEPOSIT"
//   WalletTransaction.status "PENDING" | "CONFIRMED" | "REJECTED"
//   DiscountCode.type         "PERCENT" | "FIXED"
//   Dispute.status             "OPEN" | "RESOLVED_REFUND" | "RESOLVED_RELEASE"
//   Product.status             "PENDING" | "APPROVED" | "REJECTED"
//   Category.status            "PENDING" | "APPROVED" | "REJECTED"
//   ProductStockItem.status    "AVAILABLE" | "SOLD"

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  role          String    @default("BUYER")
  walletBalance Int       @default(0)
  // Mã thành viên ngắn, dễ đọc cho admin tra cứu (KHÁC `id` ở trên — cuid
  // nội bộ, không đổi) — dạng "MMO000001", tăng dần theo thứ tự tạo tài
  // khoản, gán CỐ ĐỊNH vĩnh viễn lúc đăng ký (xem src/lib/member-code.ts).
  // Nullable — tài khoản tạo trước tính năng này chưa có cho tới khi chạy
  // scripts/backfill-member-codes.ts (chạy tay, không tự động).
  memberCode    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Cập nhật trong callback jwt() của Auth.js (src/auth.ts) mỗi khi có phiên
  // đăng nhập/làm mới token (throttle 2 phút/lần để tránh ghi DB liên tục) —
  // dùng để hiển thị "Online X trước" ở trang chi tiết sản phẩm.
  lastActiveAt  DateTime?

  // Affiliate/giới thiệu: mã của chính người dùng này (chia sẻ cho người
  // khác) + liên kết tới người đã giới thiệu mình (nếu đăng ký qua mã mời).
  // Nullable vì các tài khoản có sẵn trước khi có tính năng này chưa có mã —
  // sinh "lười" (lazy) khi họ vào trang /affiliate lần đầu, xem
  // src/lib/referral.ts. Không dùng migration backfill vì dự án dùng
  // `prisma db push` (không có thư mục migrations).
  referralCode     String?  @unique
  referredById     String?
  referredBy       User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("Referrals")
  // true khi người giới thiệu (referredBy) đã nhận hoa hồng cho CHÍNH user
  // này — đánh dấu trên người được mời (không phải người mời) để idempotent
  // dễ dàng dù có nhiều lượt mời khác nhau. Set true trong POST /api/checkout
  // khi đơn hàng đầu tiên của user này đủ điều kiện (xem REFERRAL_MIN_FIRST_ORDER_VND).
  referralRewarded Boolean  @default(false)

  // Khoá tài khoản (Admin > Người dùng) — chặn đăng nhập ngay (kiểm tra
  // trong Credentials authorize(), xem src/auth.ts), KHÔNG xoá dữ liệu.
  // Không áp dụng cho tài khoản Google OAuth hiện có (chỉ chặn được ở bước
  // authorize() của Credentials provider) — ghi rõ trong code phần đó.
  banned       Boolean   @default(false)
  bannedReason String?
  bannedAt     DateTime?

  // IP lúc đăng ký — dùng để GẮN CỜ (không chặn cứng) cặp referrer–referred
  // trùng IP để admin review (chống farming hoa hồng đa tài khoản). Xem
  // ReferralCommission.flagged + src/lib/commission.ts.
  signupIp String?

  accounts      Account[]
  sessions      Session[]
  seller        Seller?
  orders        Order[]
  walletTxs     WalletTransaction[]
  reviews       Review[]
  forumPosts    ForumPost[]
  forumComments ForumComment[]
  forumLikes    ForumLike[]
  forumReports  ForumReport[]
  disputesOpened Dispute[]
  conversationsAsUserA Conversation[] @relation("ConversationsAsUserA")
  conversationsAsUserB Conversation[] @relation("ConversationsAsUserB")
  sentMessages         Message[]
  passwordResetTokens  PasswordResetToken[]
  adminAuditLogs       AdminAuditLog[]
  commissionsEarned    ReferralCommission[] @relation("CommissionReferrer")
  commissionsGenerated ReferralCommission[] @relation("CommissionReferred")
  commissionsDisbursed ReferralCommission[] @relation("CommissionDisbursedBy")
  commissionRateChanges CommissionRateChange[]
  feeSchedulesCreated  PlatformFeeSchedule[] @relation("FeeScheduleCreatedBy")
  feeChanges           PlatformFeeChange[]   @relation("FeeChangedBy")
  // Audit: mỗi lần buyer xem nội dung giao hàng thật (OrderItem.deliveredPayload)
  // — AUDIT LỊCH SỬ ĐƠN HÀNG LỖ HỔNG 2, xem model DeliveredPayloadAccessLog.
  deliveredPayloadAccessLogs DeliveredPayloadAccessLog[]
  // Lịch sử đổi trạng thái đơn do chính user này thực hiện (buyer/seller/admin)
  // — AUDIT LỊCH SỬ ĐƠN HÀNG LỖ HỔNG 3, xem model OrderStatusHistory.
  orderStatusChangesActed OrderStatusHistory[]
  // Yêu cầu nạp USDT TRC20 đang đặt trước — xem model UsdtDepositIntent
  // (LAUNCH_AUDIT.md #1).
  usdtDepositIntents UsdtDepositIntent[]
}

// Quên mật khẩu: mã OTP 6 số lưu dạng SHA-256 hash (không lưu mã gốc) để dữ
// liệu bị rò rỉ từ DB không thể dùng trực tiếp reset mật khẩu người khác —
// mã gốc chỉ gửi qua email, xem src/lib/email.ts +
// src/app/api/auth/forgot-password/route.ts. KHÔNG @unique trên codeHash
// (khác token cũ 256-bit): mã 6 số chỉ có 1 triệu khả năng, một ràng buộc
// unique toàn cục sẽ va chạm thật giữa các user khác nhau — tra cứu luôn
// scope theo userId (tìm bằng email trước) thay vì tìm ngược từ hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Seller {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName     String
  slug         String   @unique
  description  String
  phone        String?
  facebookLink String?
  // Ảnh đại diện gian hàng do seller tự upload (Trang Bán Hàng > Tổng quan) —
  // null = chưa upload, UI tự fallback về chữ cái đầu shopName (xem
  // src/components/SellerAvatar.tsx, dùng chung mọi nơi hiện avatar seller).
  avatarUrl   String?
  // Ảnh bìa gian hàng (Trang Bán Hàng > Hồ sơ cá nhân) — hiện làm nền dải
  // header trang gian hàng công khai (/shop/[seller]) và card trong danh
  // sách người bán (/nguoi-ban). null = chưa upload, UI tự fallback về
  // gradient tông thương hiệu mặc định thay vì để trống trơn (xem
  // SellerDirectory.tsx / trang /shop/[seller]).
  coverUrl    String?
  // Hồ sơ cá nhân (Trang Bán Hàng > Hồ sơ cá nhân) — "Lĩnh vực chuyên / cam
  // kết dịch vụ", đoạn text ngắn tuỳ chọn seller tự khai để tăng độ tin cậy
  // với buyer. Nullable — không điền vẫn bán hàng bình thường. CỐ TÌNH không
  // có trường liên hệ cá nhân nào (Facebook/Zalo/Telegram/SĐT/email) ở đây
  // hay bất kỳ đâu khác trong hồ sơ — giữ giao dịch trong hệ thống, bảo vệ
  // escrow + phí sàn (xem CLAUDE.md).
  specialty   String?
  // Hạng người bán — giá trị HIỆU LỰC hiện tại (tính tự động từ dữ liệu thật,
  // xem recomputeSellerLevel() trong src/lib/seller-level.ts; ngưỡng/quyền
  // lợi từng hạng ở model SellerLevelConfig). TRƯỚC ĐÂY chỉ là số tĩnh (1
  // lúc đăng ký, 4 gán cứng cho seller demo) — giờ được cron/sự kiện tự
  // cập nhật, TRỪ KHI levelOverride khác null (admin khoá).
  level       Int      @default(1)
  // Khác null = admin GHI ĐÈ/KHOÁ hạng này — recomputeSellerLevel() bỏ qua
  // hoàn toàn seller này (không tự tăng/tụt), `level` ở trên giữ đúng giá
  // trị admin đặt. null = hoạt động tự động bình thường.
  levelOverride              Int?
  // Chống nhấp nháy khi TỤT hạng (xem recomputeSellerLevel()) — phát hiện
  // dưới ngưỡng lần đầu thì ghi 2 field này (KHÔNG đổi `level` ngay), chỉ
  // thực sự tụt sau khi vẫn dưới ngưỡng liên tục đủ
  // SellerLevelSetting.downgradeGraceDays. Hồi phục lại ngưỡng cũ trước hạn
  // thì xoá về null, không tụt.
  levelDowngradePendingTo    Int?
  levelDowngradePendingSince DateTime?
  // Lần gần nhất recomputeSellerLevel() chạy tới seller này (theo dõi/debug,
  // không phục vụ logic).
  levelRecomputedAt          DateTime?
  // Badge "Đã xác thực" hiển thị công khai trên gian hàng — TRƯỚC ĐÂY được
  // set tự động khi admin duyệt xác thực CCCD (model SellerVerification, đã
  // xoá bỏ hoàn toàn do liên quan dữ liệu cá nhân nhạy cảm). Giờ là cờ admin
  // TỰ BẬT/TẮT thủ công (Admin > Người bán, PATCH /api/admin/sellers/[id]
  // {action:"verify"|"unverify"}) theo đánh giá riêng — không còn quy trình
  // upload/duyệt giấy tờ nào đứng sau field này.
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  // Số dư quỹ bảo hiểm seller đã đóng lên sàn (hiển thị ở trang chi tiết sản
  // phẩm như 1 tín hiệu tin cậy, giống shopmini.pro) — nạp thật qua
  // /trang-ban-hang/quy-bao-hiem (POST /api/seller/insurance-deposit).
  insuranceBalance Int @default(0)

  // Telegram Bot (Trang Bán Hàng > Telegram Bot) — env-gated giống VNPay,
  // xem TELEGRAM_BOT_TOKEN trong .env.example. telegramLinkCode: mã 6 ký tự
  // tạm thời seller gửi cho bot qua lệnh /link để xác nhận đúng Chat ID là
  // của mình; xoá sau khi liên kết thành công. telegramChatId: null nghĩa là
  // chưa liên kết, không gửi thông báo.
  telegramChatId   String?
  telegramLinkCode String?

  // Khoá gian hàng (Admin > Người bán) — sản phẩm của seller vẫn còn trong
  // DB nhưng public query lọc thêm điều kiện seller.suspended=false nên
  // biến mất khỏi site (xem src/lib/queries.ts). Seller vẫn đăng nhập được
  // bình thường (không dùng User.banned) — chỉ gian hàng ngừng hoạt động.
  suspended       Boolean   @default(false)
  suspendedReason String?
  suspendedAt     DateTime?

  // Admin tự ghim vào khu "Các Seller Nổi Bật" trang chủ — cùng cơ chế với
  // Product.isFeatured/featuredOrder (xem getFeaturedSellers() trong
  // queries.ts). getAllSellersWithStats() (trang /nguoi-ban — danh sách TOÀN
  // BỘ seller) KHÔNG dùng field này, giữ nguyên hành vi cũ.
  isFeatured    Boolean @default(false)
  featuredOrder Int?

  products       Product[]
  reviews        Review[]
  auctionBids    AuctionBid[]
  discountCodes  DiscountCode[]
  // Danh mục do chính seller này đề xuất (nút "+ Thêm danh mục mới" trong
  // form đăng sản phẩm) — chỉ để admin biết ai đã đề xuất, KHÔNG có UI riêng
  // cho seller theo dõi danh sách này (ngoài phạm vi, xem CLAUDE.md).
  proposedCategories Category[]
  // Audit: mỗi lần seller giải mã/xem field nhạy cảm của 1 đơn dịch vụ (xem
  // model ServiceCredentialAccessLog).
  credentialAccessLogs ServiceCredentialAccessLog[]
  // Lịch sử đổi hạng — xem model SellerLevelHistory.
  levelHistory SellerLevelHistory[]

  // suspended luôn có mặt trong where của mọi query công khai (seller:
  // {suspended: false}) — đã áp SQL tương ứng lên Neon thủ công (xem
  // prisma/pending-sql/2026-08-17-product-listing-indexes.sql).
  @@index([suspended])
}

// Mã giảm giá do seller tự tạo, áp dụng cho TOÀN BỘ sản phẩm của chính họ
// (không áp dụng chéo sang sản phẩm seller khác trong cùng đơn) — xem
// POST /api/checkout để biết cách áp dụng an toàn trong 1 $transaction.
model DiscountCode {
  id        String    @id @default(cuid())
  sellerId  String
  seller    Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  code      String    @unique
  type      String // "PERCENT" | "FIXED"
  value     Int // % (1-100) nếu PERCENT, hoặc số tiền VNĐ cố định nếu FIXED
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// Đấu giá "vị trí vàng" (xây lại 2026-08-15) — seller khoá tiền đặt giá để
// sản phẩm của mình lọt Top N (N cấu hình được) trong ĐÚNG 1 phiên/tuần
// (tối Chủ Nhật 20:00–22:00 giờ VN, xem src/lib/auction-schedule.ts) thay vì
// mô hình cũ "6 vị trí cố định tự xoay vòng, không khoá tiền lúc đặt giá".
//
// Cấu hình singleton (id "singleton") — cùng pattern PlatformFeeSetting/
// CommissionSetting, lazy-tạo lần đầu đọc qua getAuctionSetting()
// (src/lib/auction.ts), KHÔNG cần seed thủ công.
model AuctionSetting {
  id          String   @id
  // Số vị trí vàng (Top N bid cao nhất thắng) — admin sửa qua UI.
  slotCount   Int      @default(6)
  // Giá đấu tối thiểu, áp dụng CHUNG cho mọi bid (thay floorPrice riêng
  // từng slot của hệ cũ — hệ mới chỉ còn 1 phiên/tuần).
  floorPrice  Int      @default(50000)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// 1 phiên = đúng 1 khung 20:00–22:00 tối Chủ Nhật (giờ Asia/Ho_Chi_Minh),
// windowStart/windowEnd là mốc UTC quy đổi sẵn. Chỉ được TẠO LƯỜI lúc có bid
// đầu tiên rơi đúng khung giờ (getOrCreateCurrentSession()) — tuần nào
// không ai đặt giá thì không có dòng nào, tránh rác dữ liệu. windowStart
// UNIQUE vừa xác định đúng phiên của tuần nào vừa chặn tạo trùng (2 bid đầu
// tiên cùng lúc dùng upsert theo cột này).
//   status: "OPEN" (đang nhận bid) → "PENDING_REVIEW" (đã chốt Top N, còn
//     bid PENDING_APPROVAL chờ admin) → "CLOSED" (đã duyệt/từ chối hết).
//   slotCount: N ĐÓNG BĂNG tại đúng lúc chốt phiên (đọc từ AuctionSetting
//     lúc closeAuctionSession() chạy) — null khi còn OPEN, đổi N sau khi
//     phiên đã chốt KHÔNG hồi tố phiên đó.
model AuctionSession {
  id          String    @id @default(cuid())
  windowStart DateTime  @unique
  windowEnd   DateTime
  status      String    @default("OPEN")
  slotCount   Int?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  bids AuctionBid[]
}

// 1 bid của 1 seller trong 1 phiên — @@unique([sessionId, sellerId]): tối đa
// 1 bid ACTIVE/PENDING_APPROVAL/WON mỗi seller/phiên (đổi ý = nâng giá CÙNG
// dòng, không tạo dòng mới).
//
// amount = số tiền ĐANG BỊ KHOÁ khỏi walletBalance của seller (vá "ghost
// bid" — hệ cũ không khoá gì lúc đặt giá). holdTransactionId trỏ đúng 1
// WalletTransaction đại diện khoản khoá HIỆN TẠI (type "AUCTION_HOLD",
// status PENDING trong lúc còn khoá) — nâng giá = 1 $transaction vừa hoàn
// khoá cũ (WalletTransaction cũ PENDING→REJECTED + cộng lại walletBalance)
// vừa khoá mức mới (tạo WalletTransaction mới, trừ walletBalance), UPDATE
// cột này sang bản ghi mới. Xem POST /api/auction/bids.
//
// status:
//   ACTIVE           phiên đang OPEN, tiền đang khoá, seller còn nâng giá được.
//   PENDING_APPROVAL phiên đã chốt, lọt Top N, tiền VẪN khoá, chờ admin.
//   WON              admin đã duyệt — WalletTransaction cùng dòng đổi
//                     type→"PURCHASE", status PENDING→CONFIRMED (KHÔNG trừ
//                     ví thêm lần nữa vì đã trừ từ lúc khoá).
//   LOST             phiên đã chốt, KHÔNG lọt Top N — tự động hoàn tiền
//                     ngay trong bước chốt phiên (không cần admin).
//   REJECTED         admin từ chối 1 vị trí trong Top N — đã hoàn tiền.
//
// rank: thứ hạng lúc chốt phiên (1 = giá cao nhất, null khi status=ACTIVE).
// decidedAt/decidedById: mốc + người xử lý WON/REJECTED (null với LOST vì
// đó là tự động, không phải admin).
model AuctionBid {
  id                String    @id @default(cuid())
  sessionId         String
  session           AuctionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            Seller    @relation(fields: [sellerId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  amount            Int
  status            String    @default("ACTIVE")
  holdTransactionId String?   @unique
  rank              Int?
  decidedAt         DateTime?
  decidedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  walletTransactions WalletTransaction[]

  @@unique([sessionId, sellerId])
  @@index([sessionId, status])
}

model Review {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Đánh giá gắn với 1 SẢN PHẨM cụ thể buyer đã mua — nullable vì review cũ/
  // review gửi không chọn sản phẩm cụ thể (vd từ trang shop chung) vẫn hợp
  // lệ, chỉ tính vào rating trung bình của SELLER (ratingStats() trong
  // queries.ts) chứ KHÔNG tính vào rating của bất kỳ sản phẩm nào. Review
  // mới gửi từ tab "Đánh giá" ở trang chi tiết sản phẩm luôn có productId —
  // xem POST /api/reviews. onDelete SetNull: xoá sản phẩm không làm mất
  // review (vẫn giữ nguyên cho rating gian hàng), chỉ rớt về "không gắn sản
  // phẩm nào" giống review chung.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Admin ẩn review spam/xúc phạm — cùng pattern ForumPost.hidden. Không
  // xoá cứng (giữ lại làm bằng chứng/lịch sử kiểm duyệt) — review bị ẩn
  // biến mất khỏi trang shop công khai VÀ khỏi rating trung bình tính động
  // (ratingStats() trong queries.ts), giống hệt cách ForumPost bị ẩn biến
  // mất khỏi diễn đàn công khai.
  hidden    Boolean  @default(false)

  @@unique([sellerId, userId])
  @@index([productId])
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  emoji String

  // Seller có thể tự đề xuất danh mục mới (nút "+ Thêm danh mục mới" ở cuối
  // dropdown chọn danh mục trong AddProductForm) khi sản phẩm của họ chưa
  // khớp danh mục nào có sẵn — cần admin duyệt mới hiện công khai (trang
  // chủ/trang danh mục/mega-menu), giống hệt pattern Product.status.
  // @default("APPROVED") để 10 category seed có sẵn không bị ẩn khi thêm
  // field này (migration-safety, cùng lý do đã áp dụng cho Product.status).
  status       String  @default("APPROVED")
  adminNote    String?
  proposedById String?
  proposedBy   Seller? @relation(fields: [proposedById], references: [id], onDelete: SetNull)

  // Cây danh mục động (self-reference) — cho phép mở rộng vô hạn tầng, thêm
  // nhóm cha/danh mục con mới chỉ cần thêm dữ liệu, không cần sửa code. Một
  // category là "nhóm cha" hay "lá" suy ra THUẦN CẤU TRÚC (có children hay
  // không) — cố tình KHÔNG thêm cờ isGroup/isService riêng: nhóm "Dịch Vụ"
  // trong sidebar chỉ là admin gán parentId thủ công, tách biệt hoàn toàn
  // khỏi Product.productType="SERVICE" đã có (2 khái niệm không liên quan).
  // ON DELETE SET NULL: xoá 1 nhóm cha không kéo xoá category con theo (con
  // rớt về "chưa có nhóm cha") — việc CHẶN xoá nhóm cha còn con nằm ở tầng
  // ứng dụng (route admin xoá category), không phải ràng buộc DB.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  // Thứ tự hiển thị trong cùng 1 cha (kể cả cấp gốc, parentId=null).
  sortOrder Int     @default(0)
  // Ẩn/hiện thủ công của admin — tách biệt hoàn toàn khỏi `status` (không
  // đụng luồng duyệt category do seller đề xuất).
  isActive  Boolean @default(true)

  products Product[]

  @@index([parentId])
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  description      String
  attributes       String
  price            Int
  priceMax         Int?
  originalPrice    Int?
  // Mega Sale — seller TOÀN QUYỀN tự bật/tắt khuyến mãi cho cả sản phẩm
  // (không phải riêng từng ProductVariant): kiểu "PERCENT" áp đồng loạt lên
  // price/priceMax/mọi ProductVariant.price của sản phẩm này (cùng 1 tỷ lệ
  // %, tính real-time — không lưu giá đã giảm riêng cho từng variant); kiểu
  // "FIXED" chỉ hợp lệ khi sản phẩm là giá đơn thật sự (không priceMax,
  // không variant). Không có ràng buộc DB nào giới hạn % giảm — chặn ở tầng
  // API (1-99%) để tránh giá về 0/âm, dùng chung sàn
  // MIN_ITEM_PRICE_AFTER_DISCOUNT (constants.ts) đã có sẵn cho mã giảm giá.
  // megaSaleEndsAt null = THỦ CÔNG (seller tự tắt), có giá trị = HẸN GIỜ.
  // Hết hạn tính REAL-TIME lúc đọc (xem computeEffectivePrice() trong
  // src/lib/mega-sale.ts), KHÔNG cần cron tự đổi megaSaleActive về false —
  // an toàn hơn cron vì không có rủi ro "cron lỗi thì giá vẫn sai".
  megaSaleActive     Boolean   @default(false)
  megaSaleType       String?
  megaSalePercent    Int?
  megaSaleFixedPrice Int?
  megaSaleEndsAt     DateTime?
  stock            Int      @default(0)
  sold             Int      @default(0)
  views            Int      @default(0)
  rating           Float    @default(4.5)
  reviewCount      Int      @default(0)
  verified         Boolean  @default(false)
  hot              Boolean  @default(false)
  featuredUntil    DateTime?
  // Admin tự ghim vào khu "Sản phẩm nổi bật" trang chủ (KHÁC hot/featuredUntil
  // ở trên — 2 cơ chế cũ đó vẫn giữ nguyên làm tầng auto-fill khi số sản
  // phẩm admin ghim chưa đủ 8, xem getFeaturedProducts() trong queries.ts).
  // featuredOrder chỉ có giá trị khi isFeatured=true, số nhỏ hơn hiện trước
  // — admin sắp bằng kéo-thả ở /admin/noi-bat.
  isFeatured       Boolean  @default(false)
  featuredOrder    Int?
  createdAt        DateTime @default(now())
  // Seller đánh dấu "sắp có hàng" (Trang Bán Hàng > Đặt trước). Buyer vẫn
  // trả 100% tiền như checkout bình thường (giữ nguyên hệ thống escrow có
  // sẵn) nhưng POST /api/checkout BỎ QUA kiểm tra tồn kho cho sản phẩm này
  // — stock có thể xuống 0/âm, đó là tín hiệu seller đang "nợ hàng" cần giao.
  preOrder         Boolean  @default(false)
  // Thời gian giao hàng seller CAM KẾT cho sản phẩm đang bật "Đặt trước" —
  // bắt buộc nhập khi bật preOrder (xem PATCH /api/seller/products/[productId]).
  // Nullable — null khi preOrder=false hoặc seller chưa cấu hình. Buyer mua
  // thì giá trị được SNAPSHOT sang OrderItem.deliveryDeadline ngay lúc
  // checkout (mốc auto-hoàn tiền nếu seller không giao đúng hạn) — sản phẩm
  // sửa lại sau đó KHÔNG ảnh hưởng đơn đã mua, cùng nguyên tắc chống cướp
  // quyền buyer như warrantyValue/warrantyUnit bên dưới.
  preOrderDeliveryValue Int?
  preOrderDeliveryUnit  String @default("day")

  // Thời gian bảo hành seller khai lúc đăng sản phẩm — áp dụng cho MỌI loại
  // hàng (PRODUCT/SERVICE/TUT_TRICK/TOOL). warrantyValue=0 nghĩa là "Không
  // bảo hành (bán đứt)". warrantyUnit "hour" | "day" (String tự do, theo
  // đúng quy ước dự án — không dùng enum Postgres). Đây CHỈ là cấu hình
  // seller đặt cho sản phẩm — buyer mua thì giá trị được SNAPSHOT sang
  // OrderItem.warrantyHours ngay lúc checkout (xem model OrderItem), sản
  // phẩm sửa lại sau đó KHÔNG ảnh hưởng đơn đã mua (chống seller giảm bảo
  // hành sau khi bán để cướp quyền khiếu nại buyer). Default 0/"day" cho
  // sản phẩm cũ — không hồi tố ý nghĩa gì, seller cần cập nhật lại nếu muốn
  // khai báo bảo hành.
  warrantyValue Int    @default(0)
  warrantyUnit  String @default("day")
  // Chính sách bảo hành dạng TEXT TỰ DO seller tự viết (điều kiện đổi/hoàn,
  // trường hợp không bảo hành...) — KHÁC warrantyValue/warrantyUnit ở trên
  // (đó là THỜI GIAN dạng số). CHỈ điền được lúc đăng sản phẩm mới VÀ (sau
  // đăng) khi sản phẩm CHƯA có OrderItem nào — hết đơn đầu tiên thì KHOÁ
  // VĨNH VIỄN, chặn ở server (PATCH /api/seller/products/[productId], đếm
  // lại OrderItem thật, không tin cờ từ client) — chống seller hạ chính sách
  // sau khi buyer đã mua dựa trên chính sách ban đầu. Nullable, không
  // default — null hiển thị dòng mặc định ở trang sản phẩm (ProductInfoTabs).
  warrantyPolicy String?

  // Ảnh sản phẩm thật do seller tự upload (Vercel Blob URL hoặc đường dẫn
  // /uploads/products/... khi chạy dev local không có BLOB_READ_WRITE_TOKEN
  // — xem saveProductImage() trong src/lib/uploads.ts). null thì UI tự động
  // fallback về icon theo category như trước (ProductThumbnail.tsx).
  imageUrl  String?
  // "PENDING" | "APPROVED" | "REJECTED" — sản phẩm seller tự đăng qua
  // POST /api/seller/products bắt đầu ở "PENDING", cần admin duyệt
  // (POST /api/admin/products/[id]) mới hiện công khai. Default "APPROVED"
  // (không phải "PENDING") để toàn bộ sản phẩm cũ tạo qua prisma/seed.ts
  // (đã có sẵn từ trước, coi như đã duyệt) không bị ẩn khỏi site khi field
  // này được thêm vào — API tạo sản phẩm mới set "PENDING" tường minh,
  // không dựa vào default.
  status    String   @default("APPROVED")
  adminNote String?
  // Admin tự ẩn/hiện 1 sản phẩm ĐANG SỐNG trên sàn — tách biệt hoàn toàn
  // khỏi `status` (luồng duyệt đăng mới của seller). Cùng pattern
  // Category.isActive: false = biến mất khỏi mọi query công khai nhưng
  // seller vẫn thấy trong trang quản lý sản phẩm của mình (kèm ghi chú đã
  // bị admin ẩn), khác REJECTED (seller coi như sản phẩm không tồn tại).
  isActive  Boolean  @default(true)

  // Seller tự tạm dừng bán 1 sản phẩm CỦA CHÍNH MÌNH, ĐỘC LẬP với số lượng
  // kho (Product.stock/ProductVariant.stock) — dùng khi 1 lô hàng bị lỗi (vd
  // sai mật khẩu) nhưng kho vẫn còn số lượng, seller muốn chặn mua tạm thời
  // tới khi xử lý xong. KHÁC HẲN `isActive` ở trên (đó là quyền ADMIN, không
  // phải seller) và `status` (luồng duyệt đăng, không phải tạm dừng bán).
  // true = coi như hết hàng ở mọi nơi (xem isOutOfStock() trong
  // src/lib/stock-status.ts) — ẩn khỏi khả năng mua, KHÔNG ẩn khỏi listing
  // công khai (khác isActive), seller vẫn thấy đầy đủ trong trang quản lý.
  pausedBySeller Boolean @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id])

  // "PRODUCT" | "SERVICE" — dần thay heuristic SERVICE_CATEGORY_SLUGS (xem
  // src/lib/constants.ts) vốn chỉ so category slug, không phải field DB
  // thật. Default "PRODUCT" migration-safe; 180+ sản phẩm cũ thuộc category
  // boosting/chatgpt/youtube đã được backfill sang "SERVICE" thủ công cùng
  // đợt tạo field này (xem prisma/pending-sql/2026-07-28-service-orders.sql)
  // để giữ đúng ý nghĩa heuristic cũ.
  productType String @default("PRODUCT")
  // Chỉ có ý nghĩa khi productType="SERVICE". JSON string mảng các mã
  // phương thức bàn giao seller CHẤP NHẬN cho dịch vụ này (xem
  // SERVICE_DELIVERY_METHODS trong src/lib/constants.ts, vd
  // '["add_as_admin","app_password"]') — buyer chọn 1 trong tập này lúc đặt
  // đơn, không được tự ý chọn cách khác. null/rỗng = seller chưa cấu hình
  // đủ, chặn buyer đặt đơn dịch vụ cho tới khi seller khai xong.
  serviceDeliveryMethods String?
  // Số giờ seller được xem field nhạy cảm (mật khẩu/OTP) SAU KHI bấm "Nhận
  // đơn" cho dịch vụ này — seller tự khai theo từng dịch vụ khi đăng sản
  // phẩm. null = dùng mặc định SERVICE_CREDENTIAL_DEFAULT_WINDOW_HOURS
  // (constants.ts). Validate 1-168 ở API, không phải ràng buộc DB — KHÁC
  // WARRANTY_WINDOW_HOURS (đó là SLA xử lý khiếu nại, không liên quan).
  credentialViewWindowHours Int?

  // "AUTO_STOCK" (mặc định, giữ nguyên hành vi cũ — giao ngay từ kho dữ liệu
  // text/ProductStockItem lúc thanh toán) | "MANUAL_PROVISION" (VPS/Server —
  // seller tự nhập credential theo TỪNG đơn sau khi thanh toán, xem
  // OrderItem.status "AWAITING_SELLER_DELIVERY" + serverDetail bên dưới cho
  // spec). String tự do theo đúng quy ước dự án (không dùng enum Postgres) —
  // xem DeliveryMethod union trong src/lib/constants.ts.
  deliveryMethod String @default("AUTO_STOCK")
  // Chỉ có ý nghĩa khi deliveryMethod="MANUAL_PROVISION". Chưa hỗ trợ sửa
  // sau khi tạo ở v1 (đăng sản phẩm mới nếu cần đổi spec).
  serverDetail ServerDetail?

  // "Tài khoản AI" (ChatGPT Plus, Grok...) — seller bật cờ này khi chọn ô
  // riêng ở form đăng (KHÔNG phải productType mới, vẫn productType="PRODUCT"
  // + deliveryMethod="AUTO_STOCK" y hệt Sản phẩm thường). Khi true, POST
  // /api/seller/products/[productId]/stock BẮT BUỘC mọi dòng kho seller nhập
  // sau này phải có ProductStockItem.expiresAt + nominalTermDays hợp lệ,
  // không cho bỏ trống — chốt chặn ở server, không chỉ ẩn checkbox UI. Default
  // false migration-safe cho sản phẩm cũ (xem prisma/pending-sql/2026-08-21-
  // product-requires-expiry.sql).
  requiresExpiryStock Boolean @default(false)

  // productType="TUT_TRICK" — bán NỘI DUNG HƯỚNG DẪN (kiến thức/quy trình),
  // bán lặp lại vô hạn cho nhiều buyer khác nhau (KHÔNG claim/tiêu hao như
  // ProductStockItem, KHÔNG có khái niệm kho). Đây là nội dung ĐẦY ĐỦ, riêng
  // tư — CHỈ đọc trực tiếp trong POST /api/checkout để gán vào
  // OrderItem.deliveredPayload (y hệt cơ chế "kho dữ liệu giao hàng thật"),
  // KHÔNG BAO GIỜ được thêm vào mapProduct()/Product type public — tránh lộ
  // nội dung trước khi mua qua SSR, cùng nguyên tắc deliveredPayload đã áp
  // dụng ở AUDIT LỊCH SỬ ĐƠN HÀNG LỖ HỔNG 2. "Mô tả chi tiết" (description,
  // field có sẵn) vẫn public — dùng làm teaser giới thiệu, không lộ đáp án.
  tutTrickContent String?

  // productType="TOOL" (dùng chung cho Tool lẫn AI Agent — phân biệt qua
  // Category, không tách productType riêng) — bán quy trình sử dụng + kho
  // credential mã hoá (kiểu B: mỗi buyer 1 credential riêng, có tồn kho,
  // TÁI DÙNG nguyên ProductVariant/ProductStockItem của Sản phẩm kho). Quy
  // trình sử dụng ĐẦY ĐỦ — plaintext nhưng PRIVATE/gated, cùng nguyên tắc
  // tutTrickContent ở trên (không đưa vào mapProduct()/Product public).
  toolUsageGuide String?

  // Giao TOOL bằng LINK TẢI (Google Drive/MediaFire/link riêng...) — tài
  // nguyên DÙNG CHUNG cho mọi buyer đã mua (KHÔNG tiêu hao như kho tài
  // khoản/ProductStockItem). PRIVATE/gated, đọc LIVE từ đây trong
  // POST /api/orders/[id]/reveal-delivered SAU KHI buyer đã mua + bấm "Xem"
  // — cùng nguyên tắc toolUsageGuide/tutTrickContent ở trên, KHÔNG BAO GIỜ
  // đưa vào mapProduct()/Product type public. Admin duyệt sản phẩm TOOL có
  // link này chỉ được XEM DẠNG TEXT (không tự mở), kèm cảnh báo không
  // tải/chạy file trên máy cá nhân — xem AdminProductsPanel.tsx.
  toolDeliveryLink String?

  // === ĐÃ NGỪNG DÙNG (deprecated, 2026-08-18) ===
  // 3 cột dưới đây phục vụ hình thức "seller upload file .zip lên sàn" cho
  // TOOL — đã GỠ BỎ theo quyết định bảo mật: không lưu file thực thi trên
  // máy chủ, tránh sàn trở thành nơi phát tán mã độc. Giờ TOOL CHỈ giao bằng
  // link tải (toolDeliveryLink ở trên) hoặc kho tài khoản
  // (ProductVariant/ProductStockItem). GIỮ NGUYÊN cột trong DB (không xoá,
  // tránh rủi ro migration) nhưng KHÔNG còn route/UI/logic nào đọc/ghi 3 cột
  // này nữa — luôn null cho mọi sản phẩm tạo từ nay. Có thể xoá thật khỏi DB
  // sau này nếu chắc chắn không cần khôi phục lại tính năng.
  toolFileUrl  String?
  toolFileName String?
  toolFileSize Int?

  orderItems    OrderItem[]
  auctionBids   AuctionBid[]
  variants      ProductVariant[]
  stockItems    ProductStockItem[]
  serviceFields ServiceFieldDefinition[]
  reviews       Review[]

  // 3 index tổng hợp phục vụ MỌI trang listing công khai (trang chủ, danh
  // mục, tìm kiếm, gian hàng) — status+isActive luôn xuất hiện CÙNG NHAU
  // trong where của mọi query công khai (xem productInclude/getAllProducts/
  // getProductsByCategory trong src/lib/queries.ts), nên gộp composite thay
  // vì 3 index đơn lẻ để Postgres dùng được trực tiếp cho cả lọc lẫn sắp
  // xếp mặc định (createdAt) / sắp "bán chạy" (sold) mà không cần giao
  // (intersect) nhiều index. Đã áp SQL tương ứng lên Neon thủ công trước khi
  // thêm khai báo này (xem prisma/pending-sql/2026-08-17-product-listing-indexes.sql)
  // — dự án dùng `prisma db push`, không có migration, nên schema chỉ khai
  // báo LẠI đúng những gì đã tồn tại trên DB thật.
  @@index([status, isActive, categoryId])
  @@index([status, isActive, createdAt])
  @@index([status, isActive, sold])
}

// Spec VPS/Dedicated cho sản phẩm deliveryMethod="MANUAL_PROVISION" — 1-1
// với Product. Chưa hỗ trợ sửa sau khi tạo (v1). kind/billingCycle là String
// tự do theo đúng quy ước dự án (không enum Postgres) — union type khai ở
// src/lib/constants.ts. osOptions lưu JSON-string mảng (đúng quy ước dự án,
// xem Product.attributes) — KHÔNG dùng Postgres String[].
model ServerDetail {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind        String  @default("VPS") // "VPS" | "DEDICATED"
  cpuCores    Int?
  ramGb       Int?
  storageGb   Int?
  storageType String?
  bandwidth   String?
  osOptions   String?
  location    String?
  billingCycle String @default("ONE_TIME") // "ONE_TIME" | "MONTHLY" | ...
  uptimeSla   String?
  // Seller phải nhập credential trong vòng bao nhiêu giờ sau thanh toán —
  // dùng để tính OrderItem.manualDeliveryDeadline lúc checkout. Validate
  // >=1 ở API (xem MIN_PROVISION_SLA_HOURS trong src/lib/constants.ts).
  provisionSlaHours Int @default(24)

  createdAt DateTime @default(now())
}

// Seller tự định nghĩa danh sách field buyer PHẢI nhập khi đặt 1 dịch vụ cụ
// thể (vd "Tài khoản Facebook", "Mật khẩu", "Link bài cần seeding"...).
// inputType="secret" là NGUỒN DUY NHẤT xác định "nhạy cảm" (không dùng cờ
// isSensitive riêng — tránh seller cấu hình sai khiến mật khẩu bị lưu
// plaintext): mọi field secret luôn đi vào ServiceIntake.encryptedFields,
// mọi field khác đi vào ServiceIntake.publicFields — xem
// src/lib/service-intake.ts.
model ServiceFieldDefinition {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Khoá dùng làm key trong JSON publicFields/encryptedFields — slugify từ
  // label lúc tạo (tái dùng src/lib/slug.ts), duy nhất trong phạm vi 1 product.
  fieldKey  String
  label     String
  // "text" (1 dòng, vd tài khoản) | "url" (validate dạng link) | "textarea"
  // (nhiều dòng, vd ghi chú) | "secret" (mật khẩu/OTP — LUÔN mã hoá).
  inputType String   @default("text")
  required  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Buyer nhập lúc checkout dịch vụ. Field "secret" (mật khẩu/OTP) mã hoá
// AES-256-GCM bằng khoá từ SERVICE_CREDENTIAL_ENCRYPTION_KEY (env, KHÔNG
// hardcode) — xem src/lib/service-crypto.ts. Seller chỉ giải mã được SAU
// sellerAcceptedAt và TRƯỚC sensitiveRevealDeadline; xoá cứng
// (encryptedFields/encryptionIv/encryptionAuthTag → NULL) khi OrderItem rời
// trạng thái ESCROW an toàn (RELEASED/CANCELLED) — xem
// purgeServiceIntakeSecrets() trong src/lib/service-intake.ts, gọi từ 3 nơi
// OrderItem đổi trạng thái (escrow/release, fullRefundDispute,
// partial_refund/release_seller trong admin disputes).
model ServiceIntake {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Buyer chọn 1 trong Product.serviceDeliveryMethods lúc đặt đơn.
  deliveryMethod String

  // JSON object các field KHÔNG nhạy cảm, plaintext — vd
  // {"account_username": "...", "target_link": "...", "notes": "..."}.
  publicFields String?

  // JSON object các field "secret" (mật khẩu/OTP...), đã mã hoá NGUYÊN KHỐI
  // thành 1 blob — không lưu plaintext ở đâu, không log ra console/file.
  encryptedFields   String?
  encryptionIv      String?
  encryptionAuthTag String?
  // Hỗ trợ xoay khoá sau này (versioned key) — hiện luôn =1, đọc từ
  // SERVICE_CREDENTIAL_ENCRYPTION_KEY hiện hành.
  encryptionKeyVersion Int?

  // JSON: bằng chứng trạng thái tài khoản TRƯỚC bàn giao (email/SĐT khôi
  // phục, ảnh chụp màn hình — tái dùng cơ chế lưu ảnh riêng tư đã có ở
  // src/lib/uploads.ts, KHÔNG mã hoá vì không phải bí mật, chỉ là bằng
  // chứng đối chiếu tranh chấp). Optional hoàn toàn.
  preHandoffSnapshot String?

  // Mốc seller bấm "Nhận đơn dịch vụ" — điều kiện BẮT BUỘC để xem field
  // nhạy cảm. null = seller chưa nhận, chưa xem được gì.
  sellerAcceptedAt DateTime?
  // = sellerAcceptedAt + credentialViewWindowHours, tính SẴN lúc accept
  // (đóng băng, không đổi dù seller sau này đổi credentialViewWindowHours
  // trên Product). Qua mốc này, dù chưa purge, API giải mã cũng từ chối.
  sensitiveRevealDeadline DateTime?
  // Đã xoá cứng field nhạy cảm hay chưa — idempotent, chặn purge 2 lần.
  sensitivePurgedAt DateTime?

  createdAt DateTime @default(now())

  accessLogs ServiceCredentialAccessLog[]
}

// Audit: seller nào đã giải mã/xem field nhạy cảm của 1 đơn dịch vụ, lúc
// nào — mỗi lần xem (kể cả xem lại) ghi thêm 1 dòng, không ghi đè.
model ServiceCredentialAccessLog {
  id              String        @id @default(cuid())
  serviceIntakeId String
  serviceIntake   ServiceIntake @relation(fields: [serviceIntakeId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  viewedAt        DateTime      @default(now())
  ipAddress       String?

  @@index([serviceIntakeId])
  @@index([sellerId])
}

// Biến thể/gói của 1 sản phẩm — vd Gmail: "Domain .US - Thuê 24h - Tên Việt"
// vs "Domain .Com - Thuê 24h" — mỗi biến thể có giá/kho riêng, seller tự
// thêm/sửa/xoá tại trang quản lý (src/app/quan-ly-san-pham). Khi 1 sản phẩm
// có >=1 variant, trang chi tiết sản phẩm bắt buộc chọn 1 variant trước khi
// mua — giá/kho hiệu lực lấy từ variant thay vì từ Product (Product.price/
// stock vẫn giữ nguyên làm giá trị "mặc định" cho sản phẩm chưa có variant
// nào, tương thích ngược với toàn bộ sản phẩm seed cũ).
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  price     Int
  stock     Int      @default(0)
  sold      Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  orderItems OrderItem[]
  stockItems ProductStockItem[]
}

// Kho dữ liệu giao hàng THẬT — mỗi dòng là 1 đơn vị nội dung có thể giao cho
// đúng 1 buyer (vd 1 dòng "email|password|2fa" của 1 tài khoản Gmail, 1 mã
// kích hoạt Steam key...). Seller nhập hàng loạt (mỗi dòng textarea = 1 bản
// ghi) qua Trang Bán Hàng > Sản phẩm — xem POST /api/seller/products/
// [productId]/stock. Đây là điểm khác biệt CỐT LÕI so với Product.stock/
// ProductVariant.stock (chỉ là 1 con số seller tự gõ tay, không gắn nội dung
// giao hàng thật) — model này giữ chỗ cho việc DELIVERY THẬT: khi buyer mua,
// POST /api/checkout tự động "claim" đúng số lượng bản ghi AVAILABLE, gắn
// vào OrderItem.deliveredPayload (buyer xem tại /don-hang).
//
// Sản phẩm/biến thể chỉ chuyển sang "chế độ kho thật" khi seller đã từng
// nhập >=1 bản ghi ở đây (kiểm tra bằng COUNT, không cần thêm cờ boolean
// riêng) — 180+ sản phẩm cũ chưa từng nhập kho thật vẫn hoạt động y hệt như
// trước (Product.stock/ProductVariant.stock vẫn là nguồn kiểm tra tồn kho
// duy nhất, deliveredPayload luôn null), không có gì bị phá vỡ.
model ProductStockItem {
  id        String   @id @default(cuid())
  productId String
  // onDelete: Restrict (KHÔNG Cascade) — xoá 1 Product sẽ BỊ CHẶN nếu còn bất
  // kỳ ProductStockItem nào tham chiếu (kể cả đã bán). Trước đây Cascade sẽ xoá
  // sạch kho, gồm cả bản ghi ĐÃ BÁN → mất lịch sử/nội dung giao hàng của buyer.
  // Hiện KHÔNG có route xoá Product nào (chỉ xoá variant), nên đây là lớp chặn
  // phòng thủ cho thao tác xoá tương lai / xoá tay qua Prisma Studio. Xem
  // SECURITY_AUDIT.md #9.
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  // null khi sản phẩm CHƯA có variant nào (kho gắn thẳng vào Product) — có
  // giá trị khi kho thuộc về 1 variant cụ thể. onDelete: SetNull (không
  // Cascade) để bản ghi ĐÃ BÁN (status SOLD, đã gắn vào 1 OrderItem) không
  // bao giờ bị xoá khi seller xoá variant sau này — lịch sử giao hàng của
  // buyer phải giữ nguyên vĩnh viễn. Bản ghi CHƯA BÁN (AVAILABLE) của 1
  // variant sắp xoá phải được dọn tường minh TRƯỚC khi xoá variant (xem
  // DELETE /api/seller/products/[productId]/variants/[variantId]) để tránh
  // bị "mồ côi" lẫn sang kho của Product gốc.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Nội dung giao hàng thật (email:password, mã kích hoạt...) — seller tự
  // nhập, không validate format cụ thể vì mỗi category 1 kiểu dữ liệu khác
  // nhau (Gmail vs Discord vs Steam key vs gold...). Với sản phẩm TOOL
  // (productType="TOOL"), field này là CIPHERTEXT (AES-256-GCM, tái dùng
  // src/lib/service-crypto.ts) thay vì plaintext — xem contentEncryption.
  content String
  // JSON {iv, authTag, keyVersion} khi `content` ở trên là ciphertext (chỉ
  // sản phẩm TOOL) — null nghĩa là `content` vẫn plaintext như trước (Sản
  // phẩm kho/TUT-Trick không đụng field này, không hồi tố dữ liệu cũ).
  contentEncryption String?
  // "AVAILABLE" | "SOLD" — chuyển sang SOLD NGAY khi bị claim trong
  // transaction checkout (không đợi tới lúc gắn xong orderItemId) để chặn
  // đúng trường hợp giỏ hàng có 2 dòng trùng productId+variantId (client gửi
  // thẳng lên API, không qua CartContext dedup) claim trúng cùng 1 bản ghi.
  status      String    @default("AVAILABLE")
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  soldAt      DateTime?

  // Thời hạn sử dụng — khai theo TỪNG đơn vị (không phải theo cả Product/
  // Variant) vì tài khoản nhập sỉ thường lệch hạn nhau. null = không thời
  // hạn (Gmail, tài khoản clone...), giữ nguyên hành vi bán giá cố định như
  // trước khi có tính năng này — không phá vỡ 180+ sản phẩm cũ.
  expiresAt DateTime?
  // Số ngày của gói ĐẦY ĐỦ mà đơn vị này thuộc về (vd 30 cho "1 tháng") —
  // CHỈ dùng làm mẫu số tính % ngày còn lại để prorate giá lúc checkout
  // (xem src/lib/prorate.ts), không hiển thị trực tiếp cho buyer. Bắt buộc
  // phải có giá trị nếu expiresAt có giá trị (validate ở API nhập kho, xem
  // POST /api/seller/products/[productId]/stock — không phải ràng buộc DB).
  nominalTermDays Int?

  @@index([productId, variantId, status])
}

model Order {
  id          String   @id @default(cuid())
  // Mã đơn dễ đọc/tra cứu, dạng "DH-XXXXXX" (xem src/lib/order-code.ts) — CHỈ
  // để hiển thị/tra cứu (lịch sử đơn, khiếu nại, admin tra theo mã buyer cung
  // cấp qua chat hỗ trợ). KHÔNG thay id nội bộ làm khoá chính — id ngẫu nhiên
  // (cuid) vẫn là khoá chính vì lý do bảo mật (mã dễ đọc mà đoán được thì
  // không nên dùng làm khoá chính). AUDIT LỊCH SỬ ĐƠN HÀNG — LỖ HỔNG 1.
  orderCode   String   @unique
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])
  totalAmount Int
  status      String   @default("ESCROW")
  createdAt   DateTime @default(now())
  // Ghi lại mã giảm giá ĐÃ ÁP DỤNG cho đơn này (nếu có) để đối chiếu lịch sử
  // — không dùng để tính lại tiền, chỉ mang tính hiển thị/audit.
  discountCode   String?
  discountAmount Int      @default(0)

  items    OrderItem[]
  // Hoa hồng affiliate của đơn này (nếu buyer được giới thiệu) — 1-1, tạo ở
  // POST /api/checkout với status PENDING, chốt (ELIGIBLE/CANCELLED) khi đơn
  // giải ngân xong (xem src/lib/commission.ts).
  referralCommission ReferralCommission?
  // Mọi dòng tiền liên quan đơn này (PURCHASE/PAYOUT/REFUND/INSURANCE_PAYOUT)
  // — khoá ngoại thật, thay cho việc chỉ nối qua chuỗi tự do trong `note`
  // trước đây (AUDIT LỖ HỔNG 1).
  walletTransactions WalletTransaction[]
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  sellerId         String
  productName      String
  // Snapshot tên + id variant tại thời điểm mua (variantId nullable + xoá
  // thì SetNull, KHÔNG cascade) — giữ nguyên variantLabel hiển thị trong
  // lịch sử đơn hàng ngay cả khi seller đã xoá variant đó sau này.
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel     String?
  quantity         Int
  price            Int
  status           String   @default("ESCROW")
  escrowReleaseAt  DateTime
  // Nội dung giao hàng thật — JSON string mảng (1 phần tử / 1 đơn vị đã mua,
  // khớp `quantity`), lấy từ ProductStockItem.content tại thời điểm checkout
  // claim được đủ hàng trong kho thật (xem model ProductStockItem). null khi
  // sản phẩm/biến thể CHƯA từng dùng kho thật (chế độ cũ — stock chỉ là số
  // seller tự gõ tay, không có nội dung để giao) — giữ nguyên hành vi cũ cho
  // toàn bộ đơn hàng/sản phẩm có từ trước tính năng này.
  deliveredPayload String?
  // Snapshot ngày hết hạn của (các) đơn vị đã giao cho dòng hàng này tại
  // thời điểm mua — JSON string mảng, CÙNG cấu trúc + CÙNG thứ tự index với
  // deliveredPayload (1 phần tử/1 đơn vị, khớp quantity; phần tử null nếu
  // đơn vị đó không có hạn). null khi deliveredPayload cũng null (sản phẩm
  // chưa dùng kho thật) — không phá vỡ đơn hàng cũ.
  deliveredExpiresAt String?
  // JSON MẢNG {iv,authTag,keyVersion}|null, CÙNG THỨ TỰ INDEX với
  // deliveredPayload — có giá trị khi (các) đơn vị claim được là credential
  // TOOL đã mã hoá (copy nguyên từ ProductStockItem.contentEncryption lúc
  // claim). null = deliveredPayload hoàn toàn plaintext như trước (Sản phẩm
  // kho/TUT-Trick/Dịch vụ không đụng field này). Giải mã CHỈ trong
  // POST /api/orders/[id]/reveal-delivered, không lưu bản đã giải mã ở đâu.
  deliveredPayloadEncryption String?
  // PHÍ SÀN — snapshot FREEZE tại thời điểm đặt đơn (tính hoàn toàn ở server
  // trên giá SAU giảm giá của dòng hàng này). Đổi % phí về sau KHÔNG hồi tố
  // đơn cũ vì đã lưu cứng ở đây. Giải ngân cho seller = price*quantity −
  // platformFeeAmount (xem escrow/release + disputes). Áp cho MỌI đơn/mọi
  // seller, không phụ thuộc có giới thiệu hay không.
  platformFeePercent Float @default(0)
  platformFeeAmount  Int   @default(0)
  createdAt        DateTime @default(now())
  // Thời điểm giải ngân THẬT (set đúng lúc status chuyển sang RELEASED — xem
  // POST /api/admin/escrow/release, POST /api/admin/disputes/[id] nhánh
  // partial_refund/release_seller). KHÁC escrowReleaseAt (chỉ là ngày DỰ
  // KIẾN tính lúc đặt đơn) — sàn chưa có cron tự động nên ngày giải ngân
  // thật có thể lệch vài ngày. Dùng để tính cửa sổ khiếu nại "bảo hành sau
  // giải ngân" (đền bù từ quỹ bảo hiểm seller, xem POST_RELEASE_WARRANTY
  // trong DisputePhase, src/lib/constants.ts) — null với đơn RELEASED từ
  // TRƯỚC khi thêm cột này (không backfill), đơn đó không mở được khiếu nại
  // loại này.
  releasedAt       DateTime?

  // Thời gian bảo hành (LỖ HỔNG KHIẾU NẠI — tính năng "Thời gian bảo hành").
  // warrantyHours CỐ TÌNH NULLABLE (không default 0) — phân biệt "đơn TỪ
  // TRƯỚC tính năng này" (NULL, tiếp tục dùng luật CŨ POST_RELEASE_WARRANTY_DAYS
  // cố định kể từ releasedAt làm dự phòng vĩnh viễn — xem src/lib/warranty.ts)
  // với "đơn mới, seller chọn bán đứt 0 giờ" (0 thật, KHÔNG có bảo hành sau
  // giải ngân). SNAPSHOT từ Product.warrantyValue/warrantyUnit tại thời điểm
  // checkout — sản phẩm gốc bị seller sửa sau đó KHÔNG ảnh hưởng đơn đã mua.
  warrantyHours Int?
  // Mốc buyer bấm "Xác nhận đã nhận hàng" — null = chưa xác nhận. Là điểm
  // NEO bắt đầu tính bảo hành (KHÁC releasedAt — không phụ thuộc admin bấm
  // giải ngân tay, công bằng hơn vì buyer tự xác nhận ngay khi thực sự nhận
  // được hàng/dịch vụ).
  receivedAt DateTime?
  // = receivedAt + warrantyHours, TÍNH SẴN ngay lúc set receivedAt (đóng
  // băng, không đổi dù Product.warrantyValue sau này bị seller sửa) — cùng
  // nguyên tắc ServiceIntake.sensitiveRevealDeadline. null nếu chưa
  // receivedAt hoặc warrantyHours null (đơn cũ, dùng fallback thay thế).
  warrantyExpiresAt DateTime?

  // Đặt trước (pre-order) — xây lại 2026-08-14. isPreOrder ĐÓNG BĂNG việc
  // đơn này là đặt trước TẠI THỜI ĐIỂM MUA (snapshot từ Product.preOrder) —
  // job giải ngân/hoàn tiền lọc theo CỘT NÀY, KHÔNG join ngược Product (seller
  // có thể tắt Product.preOrder sau khi bán để né chặn). Default false —
  // migration-safe, đơn TỪ TRƯỚC tính năng này giữ false, đi theo luật CŨ
  // (KHÔNG retroactive, quyết định đã chốt với người dùng).
  isPreOrder Boolean @default(false)
  // = thời điểm mua + Product.preOrderDeliveryValue/Unit SNAPSHOT lúc checkout
  // (sản phẩm sửa lại sau KHÔNG ảnh hưởng đơn đã mua). Mốc auto-hoàn tiền:
  // quá hạn này mà deliveredPayload vẫn NULL (seller chưa giao) →
  // POST /api/admin/preorders/refund-overdue tự hoàn 100% cho buyer. null
  // khi isPreOrder=false.
  deliveryDeadline DateTime?

  // Giao thủ công (VPS/Server, deliveryMethod="MANUAL_PROVISION" — TÁCH
  // RIÊNG khỏi deliveryDeadline ở trên, đó là của pre-order). = thời điểm mua
  // + ServerDetail.provisionSlaHours SNAPSHOT lúc checkout. Đơn khởi tạo ở
  // status="AWAITING_SELLER_DELIVERY"; escrowReleaseAt lúc checkout = CHÍNH
  // mốc này (mirror đúng cách pre-order dùng deliveryDeadline làm
  // escrowReleaseAt — xem POST /api/checkout). Quá hạn mà seller chưa nhập
  // credential (status vẫn AWAITING_SELLER_DELIVERY) → tự huỷ + hoàn 100%
  // cho buyer (xem src/lib/manual-provision.ts). null khi không phải đơn
  // MANUAL_PROVISION.
  manualDeliveryDeadline DateTime?

  dispute       Dispute?
  stockItems    ProductStockItem[]
  serviceIntake ServiceIntake?
  // Dòng tiền GẮN ĐÚNG dòng hàng này (PAYOUT/REFUND/INSURANCE_PAYOUT theo
  // từng OrderItem) — AUDIT LỖ HỔNG 1.
  walletTransactions WalletTransaction[]
  // Audit: mỗi lần buyer xem nội dung giao hàng thật của dòng hàng này —
  // AUDIT LỖ HỔNG 2, xem model DeliveredPayloadAccessLog.
  deliveredPayloadAccessLogs DeliveredPayloadAccessLog[]
  // Lịch sử đổi trạng thái của dòng hàng này (append-only) — AUDIT LỖ HỔNG 3,
  // xem model OrderStatusHistory.
  statusHistory OrderStatusHistory[]
}

// Lịch sử đổi trạng thái đơn (OrderItem.status) — append-only, mỗi lần đổi
// trạng thái ghi 1 dòng TRONG CÙNG transaction với thao tác đổi trạng thái đó
// (không phải fail-closed như DeliveredPayloadAccessLog — ở đây log và đổi
// trạng thái là 1 sự kiện duy nhất, thất bại thì rollback cả hai). Có đúng 6
// điểm gọi trong toàn bộ codebase (checkout tạo đơn, giải ngân ký quỹ, mở
// khiếu nại, 3 nhánh xử lý khiếu nại admin/seller) — xem
// src/lib/order-status-history.ts. `fromStatus` null nghĩa là dòng khởi tạo
// (chưa có trạng thái trước đó). `actorId` cố tình KHÔNG hiển thị tên/email
// cụ thể ra UI buyer/seller (chỉ `actorType`) — chỉ dùng cho điều tra nội bộ
// nếu cần. AUDIT LỊCH SỬ ĐƠN HÀNG — LỖ HỔNG 3.
model OrderStatusHistory {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  // "BUYER" | "SELLER" | "ADMIN" | "SYSTEM" (SYSTEM dự phòng cho cron tự động
  // sau này — hiện chưa có cron, mọi hành động đều do người dùng đã đăng nhập
  // kích hoạt).
  actorType String
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([actorId])
}

// Audit: buyer nào đã xem nội dung giao hàng thật (OrderItem.deliveredPayload
// — tài khoản/mật khẩu/mã kích hoạt) của 1 dòng hàng, lúc nào — mirror
// ServiceCredentialAccessLog (chiều seller xem dữ liệu buyer cung cấp), chiều
// ngược lại. Mỗi lần xem (kể cả xem lại) ghi thêm 1 dòng, KHÔNG ghi đè —
// append-only, không có route sửa/xoá nào. Ghi qua POST
// /api/orders/[orderItemId]/reveal-delivered, fail-closed: ghi log thất bại
// thì KHÔNG trả nội dung (mirror GET /api/admin/disputes/[id]/delivered).
// AUDIT LỊCH SỬ ĐƠN HÀNG — LỖ HỔNG 2.
model DeliveredPayloadAccessLog {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  viewedAt    DateTime  @default(now())
  ipAddress   String?

  @@index([orderItemId])
  @@index([buyerId])
}

// Khiếu nại (Trang Bán Hàng > Khiếu nại) — buyer hoặc seller mở trên 1
// OrderItem đang ESCROW (chuyển OrderItem.status sang "DISPUTED" để loại khỏi
// vòng giải ngân tự động của admin/escrow/release). CHỈ admin quyết định kết
// quả cuối: hoàn toàn bộ tiền cho buyer HOẶC giải ngân cho seller — không có
// hoàn tiền một phần, giữ đúng pattern "admin tự quyết" xuyên suốt dự án.
model Dispute {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  openedById  String
  openedBy    User      @relation(fields: [openedById], references: [id])
  reason      String
  // "OPEN" | "RESOLVED_REFUND" (hoàn toàn bộ) | "RESOLVED_PARTIAL" (hoàn một
  // phần) | "RESOLVED_RELEASE" (giải ngân seller / từ chối khiếu nại).
  status      String    @default("OPEN")
  // Pha xử lý (SECURITY_AUDIT #8 Phần B — bắt buộc bảo hành seller trước):
  // "SELLER_WARRANTY" = buyer vừa mở, seller có WARRANTY_WINDOW_HOURS để tự xử
  // (hoàn/từ chối), admin CHƯA thấy. "PLATFORM" = đã escalate lên sàn, admin xử.
  // @default("PLATFORM") để MIGRATION-SAFE: mọi dispute cũ (vốn dành cho admin)
  // giữ nguyên hành vi admin-thấy; route mở dispute set "SELLER_WARRANTY" tường
  // minh cho khiếu nại buyer mở mới.
  phase              String    @default("PLATFORM")
  // Hạn seller tự bảo hành (createdAt + WARRANTY_WINDOW_HOURS). Quá hạn thì
  // buyer được escalate lên sàn kể cả khi seller chưa phản hồi. null với dispute
  // cũ / seller tự mở (vào thẳng PLATFORM).
  warrantyDeadline   DateTime?
  // Thời điểm seller TỪ CHỐI bảo hành — set thì buyer được escalate NGAY (không
  // cần đợi hết hạn). null = seller chưa từ chối.
  warrantyRejectedAt DateTime?
  adminNote   String?
  // Số tiền THỰC hoàn cho buyer khi admin xử (full = giá trị dòng; partial =
  // phần %; release = 0/không set). Dùng để audit + hiển thị, xem
  // POST /api/admin/disputes/[id] + SECURITY_AUDIT #8.
  refundAmount Int?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

// Diễn đàn cộng đồng — bất kỳ user đăng nhập nào cũng đăng bài, bình luận
// (đóng vai trò "chat" theo từng bài viết) và thả tim 1 bài viết. Trước đây
// dữ liệu chỉ là mock tĩnh (src/data/posts.ts), giờ là dữ liệu thật.
model ForumPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("Chia sẻ")
  createdAt DateTime @default(now())
  // Admin ẩn bài vi phạm sau khi xử lý báo cáo (Admin > Diễn đàn) — ẩn khỏi
  // mọi query công khai, KHÔNG xoá cứng để giữ lịch sử kiểm duyệt.
  hidden    Boolean  @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments ForumComment[]
  likes    ForumLike[]
  reports  ForumReport[]
}

model ForumComment {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
  hidden    Boolean   @default(false)

  reports ForumReport[]
}

// Báo cáo bài viết/bình luận vi phạm (nút "Báo cáo" trên Diễn đàn) — đúng 1
// trong 2 khoá postId/commentId có giá trị, khoá còn lại null. Admin xử lý
// tại Admin > Diễn đàn: ẩn nội dung (set hidden=true) hoặc bỏ qua báo cáo.
model ForumReport {
  id         String        @id @default(cuid())
  postId     String?
  post       ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     String        @default("OPEN") // "OPEN" | "RESOLVED_HIDDEN" | "RESOLVED_DISMISSED"
  createdAt  DateTime      @default(now())

  // Mỗi user chỉ báo cáo 1 lần cho cùng 1 bài viết / 1 bình luận (chống spam
  // ngập hàng chờ kiểm duyệt — AUDIT.md #4). postId/commentId nullable: Postgres
  // coi NULL là KHÁC NHAU trong unique index, nên report bài viết (commentId=NULL)
  // và report bình luận (postId=NULL) không đụng nhau — đúng ý muốn.
  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
}

// Nhật ký thao tác quản trị (Admin > Nhật ký hoạt động) — ghi lại MỌI hành
// động duyệt/từ chối/giải ngân/khoá tài khoản... kèm admin thực hiện, phục
// vụ đối soát và trách nhiệm giải trình khi xử lý tiền/tài khoản người dùng.
// Ghi qua src/lib/audit.ts, gọi thêm 1 dòng ở cuối mỗi route admin hiện có
// — không throw nếu ghi log lỗi (không được để lỗi audit làm hỏng thao tác
// chính đã thành công).
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Mỗi user chỉ thả tim 1 lần/bài viết — bấm lại để bỏ thích (toggle qua
// @@unique, xem POST /api/forum/posts/[postId]/like).
model ForumLike {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

model WalletTransaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  type        String
  amount      Int
  status      String    @default("PENDING")
  method      String?
  note        String?
  adminNote   String?
  // TxID on-chain admin tự nhập lúc duyệt CONFIRMED (bằng chứng đã chuyển
  // USDT thật) — dùng chung với TxID buyer nhập lúc NẠP USDT (giữ nguyên ý
  // nghĩa "tham chiếu cổng thanh toán", chỉ khác hướng tiền).
  gatewayRef  String?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  // Nạp ngân hàng qua VietQR (wizard 3 bước, xem DepositPanel.tsx) — sinh Ở
  // SERVER lúc buyer xác nhận Bước 2 (POST /api/wallet/deposit-request),
  // KHÔNG tin mã/hạn từ client. UNIQUE thật trong DB (index có điều kiện
  // WHERE NOT NULL — các dòng WalletTransaction khác không có mã này).
  // Webhook SePay (POST /api/webhook/sepay) khớp giao dịch theo depositCode
  // tìm thấy trong nội dung chuyển khoản; vẫn cộng tiền dù đã quá expiresAt
  // (an toàn cho khách), chỉ ghi thêm adminNote đánh dấu khớp trễ hạn.
  depositCode String? @unique
  expiresAt   DateTime?

  // Khoá ngoại thật tới đơn hàng liên quan (AUDIT LỖ HỔNG 1 — trước đây chỉ
  // nối qua chuỗi tự do trong `note`, không JOIN được, không đáng tin cậy
  // làm bằng chứng). null với DEPOSIT/WITHDRAW (không gắn đơn nào).
  // PURCHASE (thanh toán cả đơn lúc checkout) chỉ gắn orderId, KHÔNG gắn
  // orderItemId (áp dụng cho toàn đơn, không phải 1 dòng hàng cụ thể).
  // PAYOUT/REFUND/INSURANCE_PAYOUT (theo từng dòng hàng — giải ngân/hoàn
  // tiền/đền bảo hiểm) gắn CẢ HAI. ON DELETE SET NULL: sổ cái tiền không
  // bao giờ được mất dòng nào dù Order/OrderItem phía kia có bị xoá (hiện
  // không có route nào xoá, đây là lớp phòng thủ).
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  // 4 field dưới CHỈ có giá trị khi type="WITHDRAW" và method="usdt_trc20"
  // (rút USDT qua mạng TRC20) — null với mọi dòng khác (rút ngân hàng, nạp
  // tiền...), migration-safe. Tỷ giá + số USDT được KHOÁ tại thời điểm
  // seller tạo yêu cầu (server tự lấy, không tin số client gửi lên) và
  // KHÔNG tính lại lúc admin duyệt — admin chuyển đúng usdtAmount đã khoá,
  // không phụ thuộc tỷ giá biến động sau đó. Xem src/lib/payment/
  // exchange-rate.ts (nguồn tỷ giá) + src/lib/payment/trc20.ts (validate
  // địa chỉ).
  withdrawAddress String? // Ví TRC20 đích seller nhập (đã validate base58check)
  usdtAmount      Float? // Số USDT quy đổi, khoá lúc tạo yêu cầu
  exchangeRate    Float? // Tỷ giá VNĐ/USDT dùng để quy đổi, khoá lúc tạo yêu cầu
  rateSource      String? // "coingecko" | "fallback" — nguồn tỷ giá tại thời điểm khoá

  // Thông tin tài khoản nhận CHO RÚT TIỀN (type="WITHDRAW") — JSON gộp
  // CHUNG cho các phương thức không phải USDT (bank:
  // {bankName,accountNumber,accountHolder}; usdt_trc20: {address} — nhân đôi
  // từ withdrawAddress ở trên để trang admin có 1 đường đọc chung cho cả 2
  // phương thức, KHÔNG thay thế 3 cột usdt* phía trên vì đó là dữ liệu tính
  // toán quy đổi, không chỉ là "thông tin tài khoản nhận"). Nullable, KHÔNG
  // backfill — yêu cầu rút cũ (trước cột này) đọc fallback qua `note`
  // (bank cũ) / `withdrawAddress` (usdt cũ), xem SellerWithdrawPanel.tsx +
  // AdminWithdrawalsPanel.tsx.
  recipientInfo String?

  // Khoá ngoại tới bid đấu giá vị trí vàng liên quan (type="AUCTION_HOLD"
  // lúc còn khoá/bị hoàn, hoặc "PURCHASE" sau khi admin duyệt thắng — xem
  // model AuctionBid) — cùng lý do đã áp dụng cho orderId/orderItemId ở
  // trên: nối tiền với bid bằng khoá ngoại thật, không parse chuỗi `note`.
  // null với mọi loại giao dịch khác. ON DELETE SET NULL: sổ cái tiền không
  // bao giờ mất dòng nào dù AuctionBid phía kia (giả sử) có bị xoá.
  auctionBidId String?
  auctionBid   AuctionBid? @relation(fields: [auctionBidId], references: [id], onDelete: SetNull)
}

// Vá LAUNCH_AUDIT.md #1 — chặn "cướp" TxID nạp USDT TRC20 công khai trên
// blockchain. Trước đây POST /api/wallet/deposit-usdt cộng tiền thẳng cho
// BẤT KỲ ai gọi API kèm 1 TxID hợp lệ — không có gì ràng buộc TxID đó với
// đúng người đã gửi (TxID + số tiền + địa chỉ gửi đều công khai trên
// Tronscan). Vá bằng cách buyer phải "đặt trước" 1 bản ghi ở đây TRƯỚC khi
// chuyển — hệ thống cấp 1 SỐ USDT ĐỊNH DANH RIÊNG (phần nguyên ≈ quy đổi từ
// vndAmount, 6 số thập phân cuối là mã ngẫu nhiên duy nhất trong các bản ghi
// đang PENDING). Lúc xác minh on-chain (route KHÔNG đổi tên), hệ thống khớp
// SỐ USDT THỰC NHẬN với đúng bản ghi đang chờ — tiền luôn cộng vào ví CHỦ
// YÊU CẦU (userId ở đây), KHÔNG PHẢI người gọi API xác minh. Ai cướp TxID
// gọi API bằng tài khoản khác cũng không được cộng gì, vì tài khoản đó
// không có yêu cầu nào khớp đúng số tiền trên chain.
//
// Không có UNIQUE cứng trên usdtAmountRaw (cần unique index CÓ ĐIỀU KIỆN
// WHERE status='PENDING' mới đúng ý — Prisma schema DSL không biểu diễn
// được dạng index này, và prisma db push có thể xoá mất index không khai
// báo trong schema ở lần push sau) — code tự kiểm tra trùng + retry với mã
// ngẫu nhiên khác trước khi tạo (đủ an toàn: ~999.999 khả năng cho 6 số
// thập phân, chỉ cần không trùng các yêu cầu ĐANG PENDING cùng lúc).
model UsdtDepositIntent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Số VNĐ buyer yêu cầu nạp — ĐÓNG BĂNG tại thời điểm tạo yêu cầu, đây là
  // số THỰC SỰ cộng vào ví khi khớp (không tính lại theo tỷ giá lúc xác
  // minh TxID, tránh buyer bối rối vì lệch tỷ giá giữa 2 thời điểm).
  vndAmount Int
  // Số USDT ĐỊNH DANH buyer phải chuyển, đơn vị raw (10^-6 USDT, khớp
  // decimals thật của token USDT-TRC20) — vd 20483726 = 20.483726 USDT.
  usdtAmountRaw BigInt
  // Tỷ giá + nguồn dùng để TÍNH GỢI Ý phần nguyên usdtAmountRaw lúc tạo yêu
  // cầu — chỉ để hiển thị/đối chiếu, KHÔNG dùng lại lúc khớp (khớp thuần
  // theo usdtAmountRaw).
  rate       Float
  rateSource String

  // "PENDING" (đang chờ buyer chuyển + xác minh) | "MATCHED" (đã khớp TxID,
  // đã cộng ví) | "EXPIRED" (quá hạn, không dùng được nữa — set lười khi có
  // request đọc/tạo mới đụng tới, không cần cron riêng).
  status    String   @default("PENDING")
  expiresAt DateTime

  // TxID đã khớp vào yêu cầu này (nếu MATCHED) — audit/đối chiếu.
  matchedTxid String?
  // WalletTransaction được tạo khi khớp thành công — audit/đối chiếu.
  matchedWalletTransactionId String?

  createdAt DateTime @default(now())

  @@index([userId])
  // Index chính dùng lúc khớp TxID: tìm 1 intent PENDING có đúng usdtAmountRaw.
  @@index([status, usdtAmountRaw])
}

// Chat giữa 2 user bất kỳ (buyer-seller, hoặc user với bot "Hệ Thống" —
// xem src/lib/system-bot.ts) — KHÔNG dùng khái niệm buyer/seller cứng vì hội
// thoại với bot không khớp khung đó. userAId/userBId LUÔN được chuẩn hoá
// (id nhỏ hơn xếp vào userAId) khi tạo/tìm hội thoại để 1 cặp user chỉ có
// đúng 1 Conversation dù ai nhắn trước — xem getOrCreateConversation().
model Conversation {
  id            String   @id @default(cuid())
  userAId       String
  userA         User     @relation("ConversationsAsUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String
  userB         User     @relation("ConversationsAsUserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  // Ảnh/file đính kèm (tuỳ chọn) — lưu ngoài /public (xem src/lib/uploads.ts),
  // chỉ đọc qua GET /api/messages/attachments/[messageId]
  // (verify người gọi là 1 trong 2 người tham gia hội thoại). attachmentType:
  // "IMAGE" | "FILE". content có thể rỗng nếu tin chỉ có đính kèm.
  attachmentPath String?
  attachmentName String?
  attachmentType String?
  // Ngữ cảnh KHIẾU NẠI (Cách B — SECURITY_AUDIT #8 chat theo đơn). null = tin
  // nhắn CHUNG (ChatInbox thường); có giá trị = tin thuộc luồng trao đổi của
  // đúng 1 khiếu nại (Dispute.id). CỐ TÌNH là cột String THƯỜNG (không FK
  // relation): nếu để relation onDelete:SetNull thì khi xoá Dispute, disputeId
  // bị null → tin nhắn khiếu nại LỌT vào chat chung (đúng thứ cần tránh). Để
  // cột thường: tin của khiếu nại đã xoá vẫn disputeId != null → vẫn bị loại
  // khỏi chat chung, không rò. Mọi query chat chung lọc disputeId = null; luồng
  // khiếu nại lọc disputeId = <id>. Cùng 1 Conversation buyer↔seller (không tạo
  // hội thoại mới — tránh phá @@unique([userAId,userBId]) của Conversation).
  disputeId      String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, disputeId])
}

// Hoa hồng affiliate — GHI NHẬN khi buyer (được giới thiệu) đặt đơn, nhưng
// chỉ ĐỦ ĐIỀU KIỆN giải ngân sau khi đơn RELEASED (đã qua cửa sổ ký quỹ =
// qua cửa sổ hoàn tiền/khiếu nại). Tiền hoa hồng lấy từ PHÍ MARGIN sàn thu
// trên chính giao dịch đó (chỉ thu phí ở đơn có giới thiệu — xem
// src/lib/commission.ts + escrow release), và server đảm bảo commissionAmount
// ≤ phần margin thu được (commissionPercent < marginPercent, chốt ở settings).
//   status: "PENDING"  = chờ đủ điều kiện (đơn chưa giải ngân xong)
//           "ELIGIBLE" = đủ điều kiện, chờ admin giải ngân
//           "PAID"     = đã giải ngân vào ví người giới thiệu
//           "CANCELLED"= đơn bị hoàn/huỷ hết → hoa hồng bị huỷ
model ReferralCommission {
  id             String    @id @default(cuid())
  referrerId     String
  referrer       User      @relation("CommissionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String
  referredUser   User      @relation("CommissionReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Giá trị đơn dùng để tính (chốt lúc tạo; cập nhật lại theo phần RELEASED
  // thực tế khi finalize nếu có item bị huỷ).
  orderAmount    Int
  commissionAmount Int
  // % chốt tại thời điểm phát sinh (KHÔNG hồi tố khi admin đổi % sau này).
  percentApplied       Float
  marginPercentApplied Float
  status         String    @default("PENDING")
  // Cờ đáng ngờ (không chặn cứng) — vd referrer & referred trùng signupIp.
  flagged        Boolean   @default(false)
  flaggedReason  String?
  eligibleAt     DateTime?
  paidAt         DateTime?
  disbursedById  String?
  disbursedBy    User?     @relation("CommissionDisbursedBy", fields: [disbursedById], references: [id])
  createdAt      DateTime  @default(now())

  @@index([referrerId, status])
  @@index([status])
}

// Cấu hình hoa hồng (singleton, id cố định "singleton") — admin sửa qua UI
// (Admin > Hoa hồng > Cài đặt), KHÔNG hardcode trong env.
// Ràng buộc bắt buộc ở server (mục #8): commissionPercent < phí_sàn / 2 —
// để "phần sàn thực thu ròng" (= phí sàn − hoa hồng) luôn LỚN HƠN hoa hồng.
// platformMarginPercent giữ lại cho tương thích ngược (không còn dùng làm trần
// — trần giờ suy từ PlatformFeeSetting).
model CommissionSetting {
  id                   String   @id
  commissionPercent    Float    // vd 4 = 4%
  platformMarginPercent Float   // (deprecated — xem PlatformFeeSetting)
  perReferrerCap       Int      @default(0) // 0 = không giới hạn (VNĐ / kỳ)
  capPeriodDays        Int      @default(30)
  // Kill switch (mục #9B) — TẮT thì NGỪNG phát sinh hoa hồng MỚI kể từ thời
  // điểm tắt; KHÔNG đụng các khoản đã kiếm hợp lệ (vẫn ELIGIBLE/PAID/giải ngân
  // được). Kiểm tra cờ này ở server (accrueCommission) trước khi tạo commission.
  enabled              Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  updatedById          String?
}

// KHÔNG CÒN DÙNG (2026-08-28→2026-08-29) — trước đây là bộ đếm tuần tự sinh
// User.memberCode kiểu "MMO000001", "MMO000002"... Đã đổi sang sinh NGẪU
// NHIÊN ("MM" + 8 chữ số, retry khi va UNIQUE constraint — xem
// ensureMemberCode() trong src/lib/member-code.ts) để mã không lộ thứ tự/
// tổng số tài khoản. Giữ lại model + bảng (không xoá) để khỏi phải chạy thêm
// 1 lượt SQL DROP TABLE trên Neon — bảng này an toàn, không còn code nào
// đọc/ghi vào nó nữa.
model MemberCodeCounter {
  id         String @id
  nextNumber Int    @default(1)
}

// PHÍ SÀN — % chung cho MỌI seller/mọi đơn. Singleton (id "singleton") lưu %
// MẶC ĐỊNH; các mốc theo thời gian (PlatformFeeSchedule) ghi đè trong khoảng
// hiệu lực. Admin sửa qua UI (Admin > Phí sàn), KHÔNG hardcode env. % mới chỉ
// áp cho đơn phát sinh SAU (đơn cũ freeze snapshot ở OrderItem, không hồi tố).
model PlatformFeeSetting {
  id                String   @id
  defaultFeePercent Float
  updatedAt         DateTime @updatedAt
  updatedById       String?
}

// Lịch phí theo thời gian (mục #9A) — trong [startAt, endAt] áp feePercent, hết
// kỳ tự về defaultFeePercent. Server chọn đúng % hiệu lực tại thời điểm đặt đơn.
// KHÔNG cho khoảng chồng lấn (validate server). Xoá/sửa được, ghi audit log.
model PlatformFeeSchedule {
  id          String   @id @default(cuid())
  feePercent  Float
  startAt     DateTime
  endAt       DateTime
  createdById String
  createdBy   User     @relation("FeeScheduleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([startAt, endAt])
}

// Hệ thống LEVEL (hạng) người bán — ngưỡng + quyền lợi TỪNG HẠNG (5 dòng,
// level 1-5), admin sửa qua /admin/hang-nguoi-ban (KHÔNG hardcode rải rác).
// 5 dòng + SellerLevelSetting bên dưới KHÔNG seed bằng SQL — lazy-create
// bằng code lần đầu cần tới (cùng mẫu getPlatformFeeSetting() ở trên), giá
// trị mặc định khai ở src/lib/constants.ts. Xem recomputeSellerLevel()
// trong src/lib/seller-level.ts để biết ngưỡng dùng thế nào (đạt hạng khi
// thoả ĐỒNG THỜI minDistinctBuyers + minAvgRating + minReviewCount +
// maxDisputeRatePercent).
model SellerLevelConfig {
  level     Int    @id
  name      String
  // Tên preset màu badge cố định (gray|bronze|silver|gold|diamond) — xem
  // src/components/SellerLevelBadge.tsx, KHÔNG lưu mã màu tuỳ ý để giữ đúng
  // design system.
  badgeTone String

  // "Đơn hoàn thành" = SỐ BUYER KHÁC NHAU (distinct) có ít nhất 1 OrderItem
  // status=RELEASED từ seller này, ĐÃ LOẠI tự mua (Order.buyerId !=
  // Seller.userId) — chống gian lận tự tạo đơn ảo.
  minDistinctBuyers     Int   @default(0)
  minAvgRating          Float @default(0)
  // Số review tối thiểu để đủ ĐIỀU KIỆN xét rating hạng này — chặn trường
  // hợp rating cao ảo vì mẫu quá nhỏ (vd 1 review 5 sao).
  minReviewCount        Int   @default(0)
  // Tỉ lệ khiếu nại/hoàn tiền tối đa (%) trong cửa sổ
  // SellerLevelSetting.disputeRateWindowDays gần nhất — PHẢI thấp hơn số
  // này (< , không phải <=).
  maxDisputeRatePercent Float @default(100)

  // Quyền lợi — null = không giới hạn số sản phẩm đăng bán.
  productLimit       Int?
  // % TRỪ THẲNG vào phí sàn hiệu lực cho seller hạng này — mặc định 0 (KHÔNG
  // có tác dụng gì) cho tới khi admin tự đặt khác 0. Không bao giờ để phí
  // sau khi trừ xuống dưới 0 (chặn ở nơi tính, xem platform-fee.ts).
  feeDiscountPercent Float @default(0)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Cấu hình CHUNG (không theo từng hạng) cho việc tính lại level — singleton
// (id cố định "singleton", cùng quy ước PlatformFeeSetting/CommissionSetting
// ở trên).
model SellerLevelSetting {
  id                    String   @id
  // Số ngày seller phải LIÊN TỤC dưới ngưỡng hạng hiện tại trước khi bị tụt
  // hạng thật — chống nhấp nháy do biến động ngắn hạn (1 review xấu, 1 đơn
  // trễ...). Xem Seller.levelDowngradePendingSince.
  downgradeGraceDays    Int      @default(14)
  // Trọng số 1 khiếu nại RESOLVED_PARTIAL (hoàn 1 phần) tính vào tử số tỉ lệ
  // khiếu nại — 0.5 = tính nửa lỗi so với hoàn toàn bộ (RESOLVED_REFUND) hay
  // CANCELLED (luôn = 1.0, xem seller-level.ts).
  disputePartialWeight Float    @default(0.5)
  disputeRateWindowDays Int     @default(90)
  // Lần gần nhất sweepAllSellerLevels() (cron/nút admin) chạy xong.
  lastSweepAt           DateTime?
}

// Log MỖI LẦN đổi hạng — tăng/tụt tự động (cron/sự kiện), admin ghi đè/gỡ
// ghi đè, hay backfill lần đầu triển khai. Tách khỏi AdminAuditLog (model đó
// bắt buộc adminId, không hợp cho sự kiện HỆ THỐNG tự tính) — cùng lý do
// OrderStatusHistory tách khỏi AdminAuditLog.
model SellerLevelHistory {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  fromLevel Int
  toLevel   Int
  // "auto-upgrade" | "auto-downgrade" | "admin-override" | "admin-clear-override" | "backfill".
  reason    String
  // "SYSTEM" | "ADMIN" — ADMIN thì actorId là adminId (User.id).
  actorType String
  actorId   String?
  // JSON snapshot chỉ số TẠI THỜI ĐIỂM đổi (distinctBuyers/avgRating/
  // reviewCount/disputeRatePercent) — bằng chứng đối chiếu nếu seller thắc
  // mắc sau này, không phải nguồn tính lại.
  metricsSnapshot String?
  createdAt DateTime @default(now())

  @@index([sellerId])
}

// Lịch sử đổi % phí sàn MẶC ĐỊNH — ai đổi, từ bao nhiêu sang bao nhiêu, lúc nào
// (thay đổi mốc lịch phí ghi qua AdminAuditLog).
model PlatformFeeChange {
  id          String   @id @default(cuid())
  changedById String
  changedBy   User     @relation("FeeChangedBy", fields: [changedById], references: [id])
  oldPercent  Float
  newPercent  Float
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Lịch sử đổi % hoa hồng/margin — ai đổi, từ bao nhiêu sang bao nhiêu, lúc nào.
model CommissionRateChange {
  id                   String   @id @default(cuid())
  changedById          String
  changedBy            User     @relation(fields: [changedById], references: [id])
  oldCommissionPercent Float
  newCommissionPercent Float
  oldMarginPercent     Float
  newMarginPercent     Float
  createdAt            DateTime @default(now())

  @@index([createdAt])
}

// Cấu hình thanh toán (VNPay/USDT/Ngân hàng) quản lý qua Admin thay vì chỉ
// .env — key-value đơn giản (8 key cố định: vnpay_tmn_code,
// vnpay_hash_secret, usdt_trc20_address, usdt_vnd_rate, bank_name,
// bank_account_number, bank_account_holder, bank_bin), xem
// src/lib/payment/config.ts. THIẾU dòng hoặc value rỗng = fallback về biến
// môi trường .env cùng tên — không phá vỡ cấu hình production hiện có, chỉ
// khi admin chủ động lưu qua /admin/cai-dat mới ghi đè. `value` lưu
// plaintext (kể cả vnpay_hash_secret) — quyết định có chủ đích, xem
// PROJECT_MAP.md mục "Việc 3": DB vốn đã lưu nhiều dữ liệu nhạy cảm khác
// (passwordHash...), không thêm tầng mã hoá mới cho 1 admin duy nhất.
// `updatedBy` chỉ là tiện ích hiển thị nhanh — AdminAuditLog mới là nguồn
// audit chính thức (ghi tên key đã đổi, KHÔNG ghi giá trị secret).
model PaymentConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Giao dịch webhook SePay báo về nhưng KHÔNG khớp được mã đơn (WalletTransaction
// nào đang PENDING) nào — không có userId để gắn thẳng vào WalletTransaction
// nên cần bảng riêng. Admin xem tại /admin/nap-tien, tự đối chiếu rồi "Gán
// cho user" để cộng tiền tay (POST /api/admin/sepay-unmatched/[id]). Dedup
// theo "sepayId" UNIQUE — khác cơ chế dedup của nhánh KHỚP ĐƯỢC (dùng
// WalletTransaction.gatewayRef, xem index WalletTransaction_sepay_deposit_
// txid_key) vì đây là 2 nhánh xử lý tách biệt cho cùng 1 giao dịch SePay.
model SepayUnmatchedTransaction {
  id              String    @id @default(cuid())
  sepayId         String    @unique
  gateway         String?
  amount          Int
  content         String?
  referenceCode   String?
  transactionDate DateTime?
  // UNMATCHED (mới về) | RESOLVED (đã gán cho 1 user) | IGNORED (admin xác
  // nhận không phải tiền nạp, bỏ qua).
  status                       String    @default("UNMATCHED")
  resolvedWalletTransactionId  String?
  createdAt                    DateTime  @default(now())
  resolvedAt                   DateTime?
}

// Nội dung động quản lý qua Admin (/admin/noi-dung) thay vì hardcode trong
// code — cùng shape với PaymentConfig nhưng tách bảng riêng vì khác domain
// (nội dung/marketing, không phải cấu hình thanh toán). 9 key cố định, xem
// src/lib/site-config.ts: insurance_fund_target, header_ticker_text,
// footer_facebook_url, footer_youtube_url, footer_tiktok_url,
// footer_zalo_url, footer_messenger_url, footer_phone, search_tags (JSON
// mảng chuỗi). THIẾU dòng/value rỗng = tự dùng giá trị mặc định hiện có
// trong code làm fallback — không phá vỡ giao diện hiện tại.
//
// Banner trang chủ TRƯỚC ĐÂY nằm ở đây (4 key banner_left_1/2/right_1/2,
// chỉ lưu URL ảnh) — đã chuyển hẳn sang model HomeBanner (bên dưới) để hỗ
// trợ số lượng slide động + tiêu đề/mô tả/CTA riêng từng slide. 4 dòng cũ
// (nếu admin từng cấu hình) vẫn còn trong bảng này nhưng không còn được đọc.
model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Banner trang chủ động (Admin > Nội dung trang web, AdminHomeBannerPanel) —
// slot "LARGE" (banner lớn bên trái, nhiều dòng = nhiều slide, sortOrder
// quyết định thứ tự trượt) | "SMALL_1" | "SMALL_2" (2 banner nhỏ cố định bên
// phải, mỗi slot chỉ giữ đúng 1 dòng). imageUrl null = seller/admin CHƯA gán
// ảnh riêng, UI tự fallback về phong cách mặc định trong code (nền màu +
// icon + chữ) — cùng nguyên tắc migration-safe đã dùng xuyên suốt dự án.
// title/description/ctaLabel/ctaHref cũng đều nullable, thiếu thì dùng chữ
// mặc định khớp phong cách mặc định đó (xem DEFAULT_* trong
// src/lib/home-banners.ts).
model HomeBanner {
  id          String   @id @default(cuid())
  slot        String
  sortOrder   Int      @default(0)
  imageUrl    String?
  title       String?
  description String?
  ctaLabel    String?
  ctaHref     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([slot])
}
