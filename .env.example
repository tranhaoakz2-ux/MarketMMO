# Database (PostgreSQL qua Docker — xem docker-compose.yml, chạy `docker compose up -d`)
DATABASE_URL="postgresql://marketmmo:marketmmo@localhost:5433/marketmmo"

# Auth.js (NextAuth v5) — tạo secret ngẫu nhiên: openssl rand -base64 32
AUTH_SECRET=""

# Đăng nhập Google (điền để bật nút "Đăng nhập với Google")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Xác minh chống bot Cloudflare Turnstile cho đăng nhập/đăng ký (điền để bật —
# SITE_KEY dùng ở client nên bắt buộc prefix NEXT_PUBLIC_, SECRET_KEY chỉ dùng
# server-side). Lấy tại https://dash.cloudflare.com/ > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Cổng thanh toán VNPay (điền để bật nạp tiền tự động qua VNPay)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/payment/vnpay/return"

# Chuyển khoản ngân hàng thủ công — điền để hiện số tài khoản thật cho người
# nạp tiền (thiếu thì vẫn nhận được yêu cầu nạp tiền nhưng không hiện số tài
# khoản cụ thể, admin cần tự liên hệ hướng dẫn).
# BANK_BIN là mã ngân hàng theo chuẩn Napas (dùng để tạo mã QR VietQR động qua
# img.vietqr.io, tự điền đúng số tiền + nội dung chuyển khoản theo từng yêu cầu
# nạp tiền) — điền kèm BANK_NAME/BANK_ACCOUNT_NUMBER để hiện QR, thiếu thì vẫn
# hiện số tài khoản dạng chữ như bình thường, chỉ không có ảnh QR.
# Một số mã BIN phổ biến: Vietcombank 970436, VietinBank 970415,
# BIDV 970418, Techcombank 970407, MB Bank 970422, ACB 970416, TPBank 970423.
BANK_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_HOLDER=""
BANK_BIN=""

# Nạp tiền bằng USDT mạng TRC20 — điền địa chỉ ví thật để bật tính năng.
USDT_TRC20_ADDRESS=""
USDT_VND_RATE="25400"

# Tự động hoá nạp VNĐ qua webhook SePay (POST /api/webhook/sepay) — đọc biến
# động số dư tài khoản ngân hàng ở BANK_ACCOUNT_NUMBER phía trên. Điền 1
# trong 2 (hoặc cả 2) tuỳ phương thức xác thực chọn lúc tạo webhook trên
# dashboard SePay — thiếu cả 2 thì webhook fail-closed, không cộng tiền tự
# động (buyer vẫn nạp thủ công chờ admin duyệt như trước).
SEPAY_WEBHOOK_SECRET=""
SEPAY_API_KEY=""

# Telegram Bot (Quản Lý Bán Hàng > Telegram Bot) — điền để bật tính năng liên
# kết Chat ID + gửi thông báo. Tạo bot qua @BotFather trên Telegram để lấy
# token. Thiếu key thì tính năng tự ẩn/disable, không chặn phần còn lại của app.
TELEGRAM_BOT_TOKEN=""

# Gửi email qua Resend (dùng cho luồng "Quên mật khẩu") — lấy API key tại
# https://resend.com/api-keys. Thiếu key thì link đặt lại mật khẩu chỉ in ra
# console server thay vì gửi email thật (vẫn test được đầy đủ ở dev).
# RESEND_FROM_EMAIL mặc định dùng địa chỉ sandbox onboarding@resend.dev của
# Resend (chỉ gửi được tới đúng email đã đăng ký tài khoản Resend) — cần xác
# minh 1 domain thật trên Resend rồi đổi sang địa chỉ @domain đó mới gửi được
# cho người dùng bất kỳ.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MarketMMO <onboarding@resend.dev>"

# Lưu trữ ảnh SẢN PHẨM (công khai) qua Vercel Blob — BẮT BUỘC khi deploy lên
# Vercel (filesystem serverless không lưu trữ lâu dài, ghi vào ổ đĩa cục bộ
# sẽ mất). Vào Vercel Dashboard > dự án > Storage > Create Database > Blob,
# chọn Access = Public để tạo store này — token tự động điền vào biến môi
# trường của Vercel, copy giá trị đó vào đây nếu muốn dùng Blob khi chạy dev
# local. Thiếu token thì tự động ghi vào public/uploads/products (chỉ phù
# hợp dev/host có filesystem lâu dài, KHÔNG dùng được trên Vercel).
BLOB_READ_WRITE_TOKEN=""

# Lưu trữ ảnh/file đính kèm CHAT (riêng tư) qua Vercel Blob — STORE RIÊNG với
# ảnh sản phẩm ở trên (1 store Blob chỉ chọn được public HOẶC private lúc
# tạo, không đổi lại sau). Tạo thêm 1 store khác trên Vercel Dashboard >
# Storage > Create Database > Blob, chọn Access = Private, rồi bấm "Connect
# Project" để Vercel tự sinh 2 biến môi trường theo TÊN STORE (không phải
# UPPER_CASE thông thường — GIỮ NGUYÊN chính xác 2 tên dưới đây, không tự đổi
# cách viết hoa/thường, ví dụ dưới ứng với store tên "marketmmo-chat-private"):
#   marketmmo_chat_private_READ_WRITE_TOKEN   (bắt buộc — code chỉ đọc biến này)
#   marketmmo_chat_private_STORE_ID           (Vercel tự tạo kèm theo, code hiện KHÔNG dùng tới)
# Copy giá trị 2 biến đó vào đây (không phải giá trị mẫu, đây chỉ là chỗ khai
# tên biến cho dev local) nếu muốn dùng Blob khi chạy dev local. Thiếu token
# thì tự động ghi vào thư mục /uploads NGOÀI /public trên ổ đĩa cục bộ (chỉ
# phù hợp dev/host có filesystem lâu dài, KHÔNG dùng được trên Vercel).
marketmmo_chat_private_READ_WRITE_TOKEN=""
marketmmo_chat_private_STORE_ID=""

# Mã hoá AES-256-GCM cho thông tin dịch vụ nhạy cảm (mật khẩu/OTP buyer cung
# cấp cho seller thực hiện dịch vụ) — 32 byte hex, sinh bằng
# `openssl rand -hex 32`. BẮT BUỘC (fail-closed, KHÔNG giống các key tuỳ
# chọn khác ở trên): thiếu key sẽ chặn cứng việc đặt đơn dịch vụ có trường
# nhạy cảm, không có phương án lưu tạm plaintext.
SERVICE_CREDENTIAL_ENCRYPTION_KEY=""

# Bảo vệ route cron POST /api/cron/daily (giải ngân ký quỹ + chốt phiên đấu
# giá vị trí vàng mỗi ngày) — sinh chuỗi ngẫu nhiên: openssl rand -hex 32.
# BẮT BUỘC set trên Vercel Dashboard (project > Settings > Environment
# Variables) để cron hoạt động — thiếu biến này thì route luôn trả 401,
# không chặn phần còn lại của app (2 nút admin bấm tay "Chạy giải ngân ký
# quỹ"/"Chốt phiên" vẫn hoạt động bình thường không cần biến này). KHÔNG cần
# set ở .env local (dev không chạy cron, dùng nút admin để test).
CRON_SECRET=""

# Tài khoản admin được tạo khi chạy seed
ADMIN_EMAIL="admin@marketmmo.pro"
ADMIN_PASSWORD="Admin@123456"
